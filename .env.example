# AegisOps Environment Configuration Template
# Duplicate this file to .env for local development:
# cp .env.example .env

# Application Settings
ENVIRONMENT=development
DEBUG=false
APP_NAME=AegisOps
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security & CORS (comma-separated origins)
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL with psycopg3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aegisops
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Optional Feature Flags
ENABLE_METRICS=true
ENABLE_BACKGROUND_TASKS=true

# Phase 5 & 6 Agentic Investigation & LLM Provider Configuration
# Supported providers: "fake" (default, deterministic offline) | "openai" | "anthropic"
AGENT_LLM_PROVIDER=fake
AGENT_LLM_MODEL=gpt-4o-mini
# Leave empty to use deterministic offline fake provider
AGENT_LLM_API_KEY=
AGENT_MAX_TOOL_CALLS=15
REMEDIATION_SIMULATION_ENABLED=true

# Phase 6 Observability & Drift Monitoring
DRIFT_PSI_WARNING_THRESHOLD=0.10
DRIFT_PSI_CRITICAL_THRESHOLD=0.25
